# Copy this file to .env and fill in what you need.

# Where the contact form sends messages (JSON POST).
# Create a free form at https://formspree.io and paste its endpoint, e.g.
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/abcdwxyz
VITE_CONTACT_ENDPOINT=

# Router mode: "browser" (default, clean URLs) or "hash" for static hosts
# that can't serve index.html for every path, such as GitHub Pages.
VITE_ROUTER=browser
